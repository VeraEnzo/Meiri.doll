---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { linkWhatsappProducto } from '../lib/contacto';

interface Props {
  name: string;
  description: string;
  images: ImageMetadata[];
  tags?: string[];
  price?: string;
}

const { name, description, images, tags = [], price } = Astro.props;

// La grilla es de hasta 3 columnas dentro de un contenedor de 1024px, así que
// una card nunca supera ~320px en desktop. En mobile ocupa el ancho completo.
// 960px cubre pantallas de hasta 3x de densidad; más grande que eso no aporta,
// y el `width` explícito evita que Astro genere además una copia del original.
const anchos = [320, 640, 960];
const anchoMaximo = 960;
const sizes = '(min-width: 1024px) 320px, (min-width: 640px) 50vw, 100vw';

// El botón de consulta abre WhatsApp con el nombre del producto ya escrito.
// Si no hay número configurado, cae en la zona de contacto de la página.
const consulta = linkWhatsappProducto(name);
---

<div class="product-card group bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-md transition-shadow border border-[#f3aebc]/30">
  <!-- Image carousel -->
  <div class="relative overflow-hidden bg-[#fff1b5]/30">
    {images.length > 0 ? (
      <div class="carousel-track flex transition-transform duration-500 ease-in-out">
        {images.map((src, i) => (
          <Image
            src={src}
            alt={`${name} - foto ${i + 1}`}
            widths={anchos}
            width={anchoMaximo}
            sizes={sizes}
            class="w-full flex-shrink-0 object-cover aspect-[3/4] select-none"
            loading={i === 0 ? 'eager' : 'lazy'}
            draggable="false"
          />
        ))}
      </div>
    ) : (
      <!-- Producto todavía sin fotos: placeholder en vez de un hueco vacío -->
      <div class="aspect-[3/4] flex flex-col items-center justify-center gap-3">
        <img src="/assets/svg/doll-bordo.svg" alt="" class="w-14 h-14 opacity-30" />
        <span class="text-[10px] tracking-widest uppercase text-[#9b1734]/40">
          foto próximamente
        </span>
      </div>
    )}

    {images.length > 1 && (
      <>
        <!-- Botones: siempre visibles en mobile, hover en desktop -->
        <button
          class="carousel-prev absolute left-3 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-[#9b1734] rounded-full w-8 h-8 flex items-center justify-center shadow transition-all md:opacity-0 md:group-hover:opacity-100 opacity-100 text-lg leading-none"
          aria-label="Foto anterior"
        >
          ‹
        </button>
        <button
          class="carousel-next absolute right-3 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-[#9b1734] rounded-full w-8 h-8 flex items-center justify-center shadow transition-all md:opacity-0 md:group-hover:opacity-100 opacity-100 text-lg leading-none"
          aria-label="Siguiente foto"
        >
          ›
        </button>

        <!-- Dots -->
        <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-1.5">
          {images.map((_, i) => (
            <button
              class={`carousel-dot w-1.5 h-1.5 rounded-full transition-all ${i === 0 ? 'bg-[#9b1734] w-3' : 'bg-[#9b1734]/40'}`}
              data-index={i}
              aria-label={`Ir a foto ${i + 1}`}
            />
          ))}
        </div>
      </>
    )}
  </div>

  <!-- Info -->
  <div class="p-5">
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-3">
        {tags.map(tag => (
          <span class="text-[10px] tracking-widest uppercase bg-[#f3aebc]/30 text-[#9b1734] px-2 py-0.5 rounded-full">
            {tag}
          </span>
        ))}
      </div>
    )}

    <div class="flex items-start justify-between gap-2 mb-2">
      <h3 class="font-meiri text-2xl text-[#9b1734]">{name}</h3>
      {price && (
        <span class="font-meiri text-xl text-[#9b1734] whitespace-nowrap">{price}</span>
      )}
    </div>

    {description && (
      <p class="text-sm text-[#9b1734]/70 leading-relaxed mb-4 whitespace-pre-line">{description}</p>
    )}

    <a
      href={consulta ?? '#contacto'}
      target={consulta ? '_blank' : undefined}
      rel={consulta ? 'noopener noreferrer' : undefined}
      class="inline-flex items-center gap-2 bg-[#9b1734] text-[#fff1b5] text-sm px-5 py-2.5 rounded-full hover:bg-[#7a1028] transition-colors w-full justify-center"
    >
      {consulta ? (
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.347-.347.52-.52.174-.174.232-.298.347-.497.115-.198.057-.371-.058-.52-.115-.148-.669-1.611-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
          <path d="M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.334.101 11.892c0 2.096.549 4.14 1.595 5.945L0 24l6.335-1.652c1.738.943 3.694 1.44 5.687 1.442h.005c6.581 0 11.94-5.335 11.943-11.893a11.82 11.82 0 0 0-3.45-8.448zm-8.475 18.29h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.999-3.648-.235-.374a9.816 9.816 0 0 1-1.5-5.23c.002-5.45 4.457-9.884 9.933-9.884a9.86 9.86 0 0 1 7.019 2.906 9.78 9.78 0 0 1 2.909 6.99c-.003 5.45-4.458 9.885-9.988 9.885z"/>
        </svg>
      ) : (
        <img src="/assets/simbolo/boton.svg" alt="" class="w-4 h-4 invert brightness-200" />
      )}
      consultar por este producto
    </a>
  </div>
</div>

<script>
  document.querySelectorAll('.product-card').forEach(card => {
    const track = card.querySelector('.carousel-track') as HTMLElement;
    if (!track) return;

    const dots = card.querySelectorAll('.carousel-dot') as NodeListOf<HTMLElement>;
    const total = track.children.length;
    let current = 0;

    function goTo(index: number) {
      current = (index + total) % total;
      track.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-[#9b1734]', i === current);
        dot.classList.toggle('w-3', i === current);
        dot.classList.toggle('bg-[#9b1734]/40', i !== current);
        dot.classList.toggle('w-1.5', i !== current);
      });
    }

    card.querySelector('.carousel-prev')?.addEventListener('click', () => goTo(current - 1));
    card.querySelector('.carousel-next')?.addEventListener('click', () => goTo(current + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

    // Swipe táctil
    let touchStartX = 0;
    let touchEndX = 0;

    track.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    track.addEventListener('touchend', (e: TouchEvent) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 40) {
        goTo(diff > 0 ? current + 1 : current - 1);
      }
    }, { passive: true });
  });
</script>
