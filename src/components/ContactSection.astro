---
import { contacto, linkWhatsapp, linkMail } from '../lib/contacto';

// Los canales que existen según lo que esté configurado en src/lib/contacto.ts
const hayWhatsapp = linkWhatsapp !== null;
---

<section id="contacto" class="py-24 px-6 bg-[#9b1734] scroll-mt-[88px]">
  <div class="max-w-2xl mx-auto text-center">

    <div class="flex justify-center mb-8 opacity-50">
      <img src="/assets/svg/doll-vanilla.svg" alt="" class="w-24 h-24" />
    </div>

    <h2 class="font-meiri text-5xl text-[#fff1b5] mb-6">¿te gustó algo?</h2>

    <p class="text-[#fff1b5]/85 text-base leading-relaxed mb-4 max-w-md mx-auto">
      {hayWhatsapp
        ? 'Escribinos por WhatsApp o Instagram para consultar colores disponibles, talles y stock.'
        : 'Escribinos por Instagram para consultar colores disponibles, talles y stock.'}
      También trabajamos a pedido y en pequeñas cantidades.
    </p>
    <p class="text-[#fff1b5]/70 text-sm leading-relaxed mb-10 max-w-md mx-auto">
      El tiempo de confección es de 7 a 15 días aproximadamente.
    </p>

    <p class="font-meiri text-2xl text-[#fff1b5]/60 mb-8">hecho con amor ♡</p>

    <div class="flex flex-col sm:flex-row sm:flex-wrap gap-3 justify-center">
      {linkWhatsapp && (
        <a
          href={linkWhatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-3 bg-[#fff1b5] text-[#9b1734] font-semibold text-sm px-7 py-3.5 rounded-full hover:bg-white transition-colors shadow-lg"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.347-.347.52-.52.174-.174.232-.298.347-.497.115-.198.057-.371-.058-.52-.115-.148-.669-1.611-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.334.101 11.892c0 2.096.549 4.14 1.595 5.945L0 24l6.335-1.652c1.738.943 3.694 1.44 5.687 1.442h.005c6.581 0 11.94-5.335 11.943-11.893a11.82 11.82 0 0 0-3.45-8.448zm-8.475 18.29h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.999-3.648-.235-.374a9.816 9.816 0 0 1-1.5-5.23c.002-5.45 4.457-9.884 9.933-9.884a9.86 9.86 0 0 1 7.019 2.906 9.78 9.78 0 0 1 2.909 6.99c-.003 5.45-4.458 9.885-9.988 9.885z"/>
          </svg>
          WhatsApp
        </a>
      )}
      <a
        href={contacto.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-3 bg-[#fff1b5] text-[#9b1734] font-semibold text-sm px-7 py-3.5 rounded-full hover:bg-white transition-colors shadow-lg"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        Instagram
      </a>
      <a
        href={contacto.tiktok}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-3 bg-[#fff1b5] text-[#9b1734] font-semibold text-sm px-7 py-3.5 rounded-full hover:bg-white transition-colors shadow-lg"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.76a4.85 4.85 0 0 1-1.01-.07z"/>
        </svg>
        TikTok
      </a>
    </div>

    {linkMail && (
      <p class="mt-8">
        <a
          href={linkMail}
          class="inline-flex items-center gap-2 text-[#fff1b5]/70 text-sm hover:text-[#fff1b5] underline underline-offset-4 decoration-[#fff1b5]/30 hover:decoration-[#fff1b5] transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m2 7 10 6 10-6"/>
          </svg>
          {contacto.email}
        </a>
      </p>
    )}

    <p class="mt-8 text-[#fff1b5]/40 text-xs tracking-wide">
      {hayWhatsapp
        ? 'respondemos por WhatsApp e Instagram · rosario, santa fe, argentina'
        : 'respondemos por Instagram · rosario, santa fe, argentina'}
    </p>
  </div>
</section>
